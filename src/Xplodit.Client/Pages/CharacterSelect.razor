@page "/personagem"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject GameSetupState Setup
@inject ProfileService Profile
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Loja — Xplodit</PageTitle>

<section class="screen shop-screen">
    <header class="shop-header">
        <div>
            <p class="brand-mark brand-mark-sm">XPLODIT</p>
            <h1>Visual &amp; Loja</h1>
        </div>
        <div class="shop-stats">
            <div class="wallet">🪙 <strong>@Profile.Data.Points</strong> pontos</div>
            <div class="wallet wallet-alt">🎁 <strong>@Profile.UnlockedCount</strong>/@CosmeticCatalog.All.Count coletados</div>
        </div>
    </header>

    @if (Setup.Settings.HumanPlayers == 2)
    {
        <div class="chip-row tab-row">
            <button type="button" class="chip @(_slot == 0 ? "active" : null)" @onclick="() => SwitchPlayer(0)">Jogador 1</button>
            <button type="button" class="chip @(_slot == 1 ? "active" : null)" @onclick="() => SwitchPlayer(1)">Jogador 2</button>
        </div>
    }

    <div class="shop-layout">
        <aside class="shop-preview">
            <canvas id="char-preview" class="preview-canvas" width="260" height="300"></canvas>
            <div class="preview-controls">
                <button type="button" class="btn-round" title="Girar" @onclick="() => Turn(-1)">⟲</button>
                <button type="button" class="btn-round" title="Dançar" @onclick="Dance">🕺</button>
                <button type="button" class="btn-round" title="Visual aleatório" @onclick="RandomizeAsync">🎲</button>
                <button type="button" class="btn-round" title="Girar" @onclick="() => Turn(1)">⟳</button>
            </div>
            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="shop-message @(_messageOk ? "ok" : null)">@_message</p>
            }

            <div class="color-block">
                <label>Pele</label>
                <div class="swatch-row">
                    @foreach (var color in CharacterCatalog.SkinColors)
                    {
                        <button type="button" class="swatch @(L.SkinColor == color ? "active" : null)" style="background:@color"
                                @onclick="() => Change(() => L.SkinColor = color)"></button>
                    }
                </div>
                <label>Cabelo</label>
                <div class="swatch-row">
                    @foreach (var color in CharacterCatalog.HairColors)
                    {
                        <button type="button" class="swatch @(L.HairColor == color ? "active" : null)" style="background:@color"
                                @onclick="() => Change(() => L.HairColor = color)"></button>
                    }
                </div>
                <label>Chapéu</label>
                <div class="swatch-row">
                    @foreach (var color in CharacterCatalog.ClothingColors)
                    {
                        <button type="button" class="swatch @(L.HatColor == color ? "active" : null)" style="background:@color"
                                @onclick="() => Change(() => L.HatColor = color)"></button>
                    }
                </div>
                <label>Roupa</label>
                <div class="swatch-row">
                    @foreach (var color in CharacterCatalog.ClothingColors)
                    {
                        <button type="button" class="swatch @(L.PrimaryColor == color ? "active" : null)" style="background:@color"
                                @onclick="() => Change(() => L.PrimaryColor = color)"></button>
                    }
                </div>
                <label>Calça</label>
                <div class="swatch-row">
                    @foreach (var color in CharacterCatalog.ClothingColors)
                    {
                        <button type="button" class="swatch @(L.SecondaryColor == color ? "active" : null)" style="background:@color"
                                @onclick="() => Change(() => L.SecondaryColor = color)"></button>
                    }
                </div>
            </div>
        </aside>

        <div class="shop-main">
            <nav class="shop-tabs">
                @foreach (var slot in CosmeticCatalog.Slots)
                {
                    var owned = CosmeticCatalog.InSlot(slot).Count(Profile.IsUnlocked);
                    var total = CosmeticCatalog.InSlot(slot).Count();
                    <button type="button" class="shop-tab @(_tab == slot ? "active" : null)" @onclick="() => SelectTab(slot)">
                        <span class="shop-tab-icon">@CosmeticCatalog.SlotIcon(slot)</span>
                        <span>@CosmeticCatalog.SlotName(slot)</span>
                        <small>@owned/@total</small>
                    </button>
                }
            </nav>

            <label class="filter-toggle">
                <input type="checkbox" checked="@_onlyOwned" @onchange="e => { _onlyOwned = (bool)e.Value!; _thumbsDirty = true; }" />
                Mostrar só meus itens
            </label>

            <div class="item-grid">
                @foreach (var item in VisibleItems)
                {
                    var unlocked = Profile.IsUnlocked(item);
                    var equipped = L.Get(item.Slot) == item.Id;
                    var affordable = Profile.Data.Points >= item.Price;
                    <button type="button" class="item-card rarity-@item.Rarity.ToString().ToLowerInvariant() @(equipped ? "equipped" : null) @(unlocked ? null : "locked")"
                            @onclick="() => PickAsync(item)">
                        <canvas id="@ThumbId(item)" class="item-thumb" width="96" height="96"></canvas>
                        <span class="item-name">@item.Name</span>
                        <span class="item-rarity">@CosmeticCatalog.RarityName(item.Rarity)</span>
                        @if (equipped)
                        {
                            <span class="item-price equipped-tag">✔ Equipado</span>
                        }
                        else if (unlocked)
                        {
                            <span class="item-price owned">Usar</span>
                        }
                        else
                        {
                            <span class="item-price @(affordable ? "can-buy" : "too-expensive")">🪙 @item.Price</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    <footer class="screen-footer">
        <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/modo")'>Voltar</button>
        <button class="btn btn-primary" @onclick="Continue">Escolher arena</button>
    </footer>
</section>

@code {
    private int _slot;
    private CosmeticSlot _tab = CosmeticSlot.Hat;
    private bool _onlyOwned;
    private string? _message;
    private bool _messageOk;
    private int _facing = 2;
    private bool _thumbsDirty = true;
    private int _danceNonce;

    private CharacterLoadout L => Setup.Loadouts[Math.Min(_slot, Setup.Settings.HumanPlayers - 1)];

    private IEnumerable<CosmeticItem> VisibleItems =>
        CosmeticCatalog.InSlot(_tab).Where(i => !_onlyOwned || Profile.IsUnlocked(i));

    private static string ThumbId(CosmeticItem item) => $"thumb-{item.Slot}-{item.Id}";

    protected override async Task OnInitializedAsync()
    {
        await Profile.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var look = LoadoutJs.From(L);
        await Js.InvokeVoidAsync("xploditPreview.draw", "char-preview", look, CharacterCatalog.SlotColors[_slot], _facing, _danceNonce);

        if (_thumbsDirty)
        {
            _thumbsDirty = false;
            var thumbs = VisibleItems.Select(i => new { canvasId = ThumbId(i), slot = i.Slot.ToString().ToLowerInvariant(), id = i.Id }).ToArray();
            await Js.InvokeVoidAsync("xploditPreview.thumbs", thumbs, look);
        }
    }

    private void SelectTab(CosmeticSlot slot)
    {
        _tab = slot;
        _thumbsDirty = true;
        _message = null;
    }

    private void SwitchPlayer(int slot)
    {
        _slot = slot;
        _thumbsDirty = true;
    }

    private void Turn(int delta)
    {
        // Facing order around the character: down, right, up, left.
        int[] order = [2, 4, 1, 3];
        var index = Array.IndexOf(order, _facing);
        _facing = order[(index + delta + order.Length) % order.Length];
    }

    private void Dance() => _danceNonce++;

    private async Task Change(Action apply)
    {
        apply();
        _message = null;
        _thumbsDirty = true;
        await Profile.SaveAsync();
    }

    private async Task PickAsync(CosmeticItem item)
    {
        if (!Profile.IsUnlocked(item))
        {
            if (!await Profile.TryBuyAsync(item))
            {
                _message = $"Faltam {item.Price - Profile.Data.Points} pontos para \"{item.Name}\". Jogue partidas e cumpra missões!";
                _messageOk = false;
                return;
            }

            _message = $"🎉 {item.Name} desbloqueado!";
            _messageOk = true;
        }
        else
        {
            _message = null;
        }

        L.Set(item.Slot, item.Id);
        if (item.Slot == CosmeticSlot.Dance)
        {
            _danceNonce++;
        }

        _thumbsDirty = true;
        await Profile.SaveAsync();
    }

    private async Task RandomizeAsync()
    {
        var random = new Random();
        foreach (var slot in CosmeticCatalog.Slots)
        {
            var owned = CosmeticCatalog.InSlot(slot).Where(Profile.IsUnlocked).ToList();
            L.Set(slot, owned[random.Next(owned.Count)].Id);
        }

        L.SkinColor = CharacterCatalog.SkinColors[random.Next(CharacterCatalog.SkinColors.Count)];
        L.HairColor = CharacterCatalog.HairColors[random.Next(CharacterCatalog.HairColors.Count)];
        L.HatColor = CharacterCatalog.ClothingColors[random.Next(CharacterCatalog.ClothingColors.Count)];
        L.PrimaryColor = CharacterCatalog.ClothingColors[random.Next(CharacterCatalog.ClothingColors.Count)];
        L.SecondaryColor = CharacterCatalog.ClothingColors[random.Next(CharacterCatalog.ClothingColors.Count)];
        _message = "🎲 Visual sorteado com seus itens!";
        _messageOk = true;
        _thumbsDirty = true;
        await Profile.SaveAsync();
    }

    private async Task Continue()
    {
        await Profile.SaveAsync();
        Nav.NavigateTo("/mapa");
    }
}
